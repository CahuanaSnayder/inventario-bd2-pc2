# Cadena de conexión a PostgreSQL
# Local:   postgresql://postgres:TU_CLAVE@localhost:5432/inventario
# Railway: copia la variable DATABASE_PUBLIC_URL del servicio Postgres
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/inventario

# Clave para firmar los tokens JWT (cualquier texto largo y aleatorio)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

PORT=3000
